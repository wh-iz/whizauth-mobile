{
  "expo": {
    "name": "WhizAuth",
    "slug": "whizauth-mobile",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#07090e"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "dev.whizard.auth",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#07090e"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-asset"
    ]
  }
}
